---
/**
 * Resources and Media — the complimentary aerial film and photography
 * programme, and how to request coverage.
 *
 * Copy follows the original site.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import Grid from '../components/ui/Grid.astro';
import Button from '../components/ui/Button.astro';
import FeatureTile from '../components/ui/FeatureTile.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { media, mediaOfferings, filmRequest } from '../data/programs';
import { contact, links, images } from '../data/org';

const offeringIcons = ['video', 'sparkle', 'shield'] as const;
---

<BaseLayout
  title="Resources and Media — Treasure Valley Ultimate"
  description={media.lede}
>
  <PageHero eyebrow={media.eyebrow} title={media.headline} lede={media.lede} />

  <Section tone="page">
    <Container>
      <div class="intro">
        <div class="intro__prose">
          <p>{media.intro}</p>
          <p>{media.body}</p>
        </div>

        <figure class="intro__media">
          <img
            src={images.action}
            alt="A player reaching for a disc during a tournament game."
            width="1200"
            height="1200"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </Container>
  </Section>

  <Section tone="raised">
    <Container>
      <SectionHeader eyebrow="What we offer" title="Free media services for local programs" />
      <Grid min="17rem">
        {
          mediaOfferings.map((offering, index) => (
            <Card>
              <FeatureTile
                title={offering.title}
                icon={offeringIcons[index]}
              >
                <p>{offering.body}</p>
              </FeatureTile>
            </Card>
          ))
        }
      </Grid>
    </Container>
  </Section>

  <!-- YouTube -->
  <Section tone="inverse" class="on-inverse">
    <Container>
      <div class="film">
        <div class="film__body">
          <Eyebrow>Film archive</Eyebrow>
          <h2 class="film__title">Watch film on YouTube</h2>
          <p class="film__text">
            We archive and share game film, tournament showcases, and community
            highlights on our official YouTube channel. Watch full-length games, study
            local team matchups, and follow competitive Ultimate in Idaho.
          </p>
          <Button href={links.youtube} size="lg" external>
            Watch on YouTube
          </Button>
        </div>

        <figure class="film__frame">
          <div class="film__thumb">
            <img
              src="https://img.youtube.com/vi/47sKaHp_PuY/maxresdefault.jpg"
              alt="Aerial game film from the Treasure Valley Ultimate YouTube channel."
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="film__caption">
            A highlight reel from our aerial game film archive.
          </figcaption>
        </figure>
      </div>
    </Container>
  </Section>

  <!-- Request coverage -->
  <Section tone="page">
    <Container>
      <div class="request">
        <div class="request__body">
          <SectionHeader
            eyebrow="Request coverage"
            title={filmRequest.title}
            lede={filmRequest.lede}
            layout="split"
          />
          <p class="request__note">{filmRequest.note}</p>
          <Button href={`mailto:${contact.admin.email}`} size="lg">
            Email {contact.admin.email}
          </Button>
        </div>

        <ol class="steps">
          {
            filmRequest.steps.map((step, index) => (
              <li class="steps__item">
                <span class="steps__index">{index + 1}</span>
                <span class="steps__text">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .intro__prose {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--layout-measure);
  }

  .intro__prose p {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .intro__media {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: var(--border-width) solid var(--line-subtle);
    box-shadow: var(--shadow-sm);
  }

  .intro__media img {
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* -------------------------------------------------------------
   * Film
   * ----------------------------------------------------------- */

  .film {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-5);
    background: color-mix(in oklab, var(--color-pine-900) 50%, transparent);
    border: var(--border-width) solid var(--line-inverse);
    border-radius: var(--radius-xl);
  }

  .film__body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .film__title {
    font-size: var(--text-xl);
  }

  .film__text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-pine-200);
  }

  .film__frame {
    margin: 0;
  }

  .film__thumb {
    overflow: hidden;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--line-inverse);
    aspect-ratio: 16 / 9;
  }

  .film__thumb img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .film__caption {
    margin-block-start: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-pine-300);
  }

  /* -------------------------------------------------------------
   * Request
   * ----------------------------------------------------------- */

  .request {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .request__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .request__body :global(.header) {
    margin-block-end: 0;
  }

  .request__note {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-tertiary);
    max-inline-size: var(--layout-measure);
  }

  .steps {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    margin: 0;
    list-style: none;
    background: var(--surface-accent-soft);
    border: var(--border-width) solid var(--line-accent);
    border-radius: var(--radius-lg);
  }

  .steps__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin: 0;
  }

  .steps__index {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-pine-900);
    background: var(--color-sunset-400);
    border-radius: 50%;
  }

  .steps__text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    padding-block-start: 0.25em;
  }

  @media (min-width: 48rem) {
    .intro {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-7);
    }

    .film {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--space-7);
      padding: var(--space-6);
    }

    .request {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>