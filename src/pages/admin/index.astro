---
/**
 * Staff index at `/admin/`.
 *
 * Not linked from anywhere and not in the sitemap: it exists so nobody has to
 * remember a URL during an event. The password is a convenience gate, not
 * authentication — see the note on `adminPassword` — so nothing here is
 * private, only tucked away.
 *
 * The links come first and the teams snapshot sits at the foot.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import TeamsSnapshot from '../../components/admin/TeamsSnapshot.astro';
import {
  adminGroups,
  adminLinkCount,
  adminPassword,
  adminUnlockKey,
} from '../../data/admin';
---

<BaseLayout
  title="Site index — Treasure Valley Ultimate"
  description="Internal index of every page and destination Treasure Valley Ultimate runs."
  noindex
>
  <Section tone="page">
    <Container>
      <div class="index">
        <header class="index__intro">
          <Eyebrow>Staff</Eyebrow>
          <h1 class="index__title">Site index</h1>
          <p class="index__lede">
            Every page and destination we run, including the ones deliberately kept
            out of the sitemap, with the current team list at the foot.
          </p>
        </header>

        <form class="gate" data-admin-gate>
          <label class="gate__label" for="site-password">Password</label>
          <div class="gate__row">
            <input
              class="gate__input"
              id="site-password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              aria-describedby="site-password-error"
              data-admin-password
            />
            <Button type="submit" variant="solid">Unlock</Button>
          </div>
          <p class="gate__error" id="site-password-error" data-admin-error role="alert" hidden>
            That password does not match.
          </p>
        </form>

        <div class="panel" data-admin-panel tabindex="-1" hidden>
          <div class="panel__bar">
            <p class="panel__count">{adminLinkCount} links</p>
            <div class="panel__controls">
              <button class="panel__control" type="button" data-admin-lock>Lock</button>
            </div>
          </div>

          {
            adminGroups.map((group) => (
              <section class="group" aria-labelledby={`group-${group.id}`}>
                <div class="group__head">
                  <h2 class="group__title" id={`group-${group.id}`}>
                    {group.title}
                  </h2>
                  <p class="group__summary">{group.summary}</p>
                </div>

                <ul class="links">
                  {group.links.map((link) => (
                    <li class="link">
                      <a class="link__anchor" href={link.href}>
                        {link.label}
                      </a>
                      <p class="link__path">{link.href}</p>
                      {link.note && <p class="link__note">{link.note}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }

          <TeamsSnapshot />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<script is:inline define:vars={{ adminPassword, adminUnlockKey }}>
  (() => {
    const gate = document.querySelector('[data-admin-gate]');
    const panel = document.querySelector('[data-admin-panel]');
    const input = document.querySelector('[data-admin-password]');
    const error = document.querySelector('[data-admin-error]');
    const lock = document.querySelector('[data-admin-lock]');
    if (!gate || !panel || !input || !error || !lock) return;

    const read = () => {
      try {
        return localStorage.getItem(adminUnlockKey);
      } catch {
        return null;
      }
    };

    const remember = (value) => {
      try {
        if (value === null) localStorage.removeItem(adminUnlockKey);
        else localStorage.setItem(adminUnlockKey, value);
      } catch {
        /* Storage blocked: the unlock lasts until the page is reloaded. */
      }
    };

    const show = (focus) => {
      gate.hidden = true;
      panel.hidden = false;
      if (focus) panel.focus();
    };

    gate.addEventListener('submit', (event) => {
      event.preventDefault();
      if (input.value.trim() === adminPassword) {
        error.hidden = true;
        remember('1');
        show(true);
        return;
      }
      error.hidden = false;
      input.select();
    });

    lock.addEventListener('click', () => {
      remember(null);
      panel.hidden = true;
      gate.hidden = false;
      error.hidden = true;
      input.value = '';
      input.focus();
    });

    if (read() === '1') show(false);
  })();
</script>

<style>
  /* Hiding is a state change on elements that also have a display rule. */
  [hidden] {
    display: none !important;
  }

  .index {
    display: grid;
    gap: var(--space-5);
    max-inline-size: 58rem;
  }

  .index__title {
    font-size: var(--text-3xl);
  }

  .index__lede {
    max-inline-size: var(--layout-measure);
    margin-block-start: var(--space-2);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  /* -------------------------------------------------------------
   * Password gate
   * ----------------------------------------------------------- */

  .gate {
    display: grid;
    gap: var(--space-2);
    max-inline-size: 28rem;
  }

  .gate__label {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--text-primary);
  }

  .gate__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: stretch;
  }

  .gate__input {
    flex: 1 1 12rem;
    min-inline-size: 0;
    padding: var(--space-3) var(--space-4);
    font: inherit;
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--surface-raised);
    border: var(--border-width-thick) solid var(--line-default);
    border-radius: var(--radius-md);
  }

  .gate__input:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .gate__error {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-critical);
  }

  /* -------------------------------------------------------------
   * The index itself
   * ----------------------------------------------------------- */

  .panel {
    display: grid;
    gap: var(--space-6);
    padding-block-start: var(--space-2);
  }

  .panel__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-width-thick) solid var(--line-strong);
  }

  .panel__count {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .panel__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .panel__control {
    min-block-size: 2rem;
    padding: var(--space-1) var(--space-3);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--text-secondary);
    background: transparent;
    border: var(--border-width) solid var(--line-default);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      color var(--motion-fast) var(--ease-out-soft),
      border-color var(--motion-fast) var(--ease-out-soft);
  }

  .panel__control:hover {
    color: var(--text-primary);
    border-color: var(--line-strong);
  }

  .group {
    display: grid;
    gap: var(--space-3);
  }

  .group__title {
    font-size: var(--text-xl);
  }

  .group__summary {
    max-inline-size: var(--layout-measure);
    margin-block-start: var(--space-1);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .links {
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: var(--border-width) solid var(--line-subtle);
  }

  .link {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    margin: 0;
    border-block-end: var(--border-width) solid var(--line-subtle);
  }

  .link__anchor {
    font-weight: 650;
    color: var(--text-link);
    overflow-wrap: anywhere;
  }

  .link__path {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-tertiary);
    overflow-wrap: anywhere;
  }

  .link__note {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .gate__row :global(.btn) {
    flex: none;
  }
</style>
