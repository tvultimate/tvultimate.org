---
/**
 * Partner Information. Covers what the umbrella organisation provides for a
 * club team, and how to affiliate.
 *
 * Copy follows the original site.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import FeatureTile from '../../components/ui/FeatureTile.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { partnerClubs, sawtooth } from '../../data/clubs';
import { contact, images } from '../../data/org';

/** What the umbrella covers on a club's behalf. */
const infrastructure = [
  'Tournament entry and bid fees',
  'Practice field rental support',
  'Coaching and clinician coordination',
  'Media, film, and promotional support',
  '501(c)(3) fiscal sponsorship and tax-deductible giving',
  'Gear, cones, scoreboards, and shared equipment',
];
---

<BaseLayout
  title="Partner Information — Treasure Valley Ultimate"
  description="Treasure Valley Ultimate provides professional infrastructure for teams so players and coaches can focus on competition and player growth."
>
  <PageHero
    eyebrow="Partner Clubs"
    title={partnerClubs.headline}
    lede={partnerClubs.intro}
  />

  <!-- Current partner club -->
  <Section tone="page">
    <Container>
      <div class="partner">
        <figure class="partner__media">
          <img
            src={images.sawtoothLogo}
            alt="Sawtooth Ultimate"
            width="738"
            height="477"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="partner__body">
          <h2 class="partner__title">{sawtooth.name}</h2>
          <p class="partner__text">
            Sawtooth is Idaho’s premier competitive Open club team. Named after the
            Sawtooth mountain range, we compete in the Big Sky Section and the Norwest
            Region.
          </p>
          <Button href="/partner-clubs/sawtooth-ultimate/">
            Learn About Sawtooth
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <!-- What the umbrella provides -->
  <Section tone="raised">
    <Container>
      <div class="columns">
        <div class="columns__list">
          <SectionHeader title="What the umbrella covers" level={2} />
          <ul class="checks">
            {
              infrastructure.map((item) => (
                <li class="checks__item">
                  <span class="checks__icon">
                    <Icon name="check" />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <figure class="columns__media">
          <img
            src={images.huddle}
            alt="A club team huddled together on the field before a game."
            width="1200"
            height="1200"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </Container>
  </Section>

  <!-- How to affiliate -->
  <Section tone="accent">
    <Container>
      <div class="affiliate">
        <Card class="affiliate__card">
          <FeatureTile
            title={partnerClubs.cta.title}
            icon="users"
            href={`mailto:${contact.general.email}`}
            cta={`Email ${contact.general.email}`}
          >
            <p>{partnerClubs.cta.body}</p>
          </FeatureTile>
        </Card>

        <div class="affiliate__steps">
          <h3 class="affiliate__steps-title">What happens next</h3>
          <ol class="steps">
            <li class="steps__item">
              <span class="steps__index">1</span>
              <span>
                Get in touch with us about your club team and the season you are
                planning.
              </span>
            </li>
            <li class="steps__item">
              <span class="steps__index">2</span>
              <span>
                We walk through the 501(c)(3) umbrella arrangement and what fiscal
                sponsorship covers for your team.
              </span>
            </li>
            <li class="steps__item">
              <span class="steps__index">3</span>
              <span>
                Your team affiliates, and gains access to tournament support, gear,
                and coaching coordination.
              </span>
            </li>
          </ol>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  /* -------------------------------------------------------------
   * Partner club feature
   * ----------------------------------------------------------- */

  .partner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .partner__media {
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-5);
    background: var(--surface-inverse);
    border-radius: var(--radius-lg);
  }

  .partner__media img {
    inline-size: min(100%, 20rem);
    block-size: auto;
  }

  .partner__body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .partner__title {
    font-size: var(--text-2xl);
  }

  .partner__text {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  /* -------------------------------------------------------------
   * Coverage list
   * ----------------------------------------------------------- */

  .columns {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .columns__list {
    display: grid;
    gap: var(--space-4);
  }

  .checks {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .checks__item {
    display: flex;
    gap: var(--space-3);
    align-items: start;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .checks__icon {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.1em;
    color: var(--text-accent);
  }

  .columns__media {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: var(--border-width) solid var(--line-subtle);
  }

  .columns__media img {
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* -------------------------------------------------------------
   * Affiliate steps
   * ----------------------------------------------------------- */

  .affiliate {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .affiliate__steps {
    display: grid;
    gap: var(--space-3);
  }

  .affiliate__steps-title {
    font-size: var(--text-xl);
  }

  .steps {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .steps__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .steps__index {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-pine-900);
    background: var(--color-sunset-300);
    border-radius: 50%;
  }

  @media (min-width: 48rem) {
    .partner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-7);
    }

    .columns {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-7);
    }

    .affiliate {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-7);
    }
  }
</style>