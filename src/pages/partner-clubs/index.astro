---
/**
 * Partner Information. Covers what the umbrella organisation provides for a
 * club team, and how to affiliate.
 *
 * Copy follows the original site.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import FeatureTile from '../../components/ui/FeatureTile.astro';
import Button from '../../components/ui/Button.astro';
import { partnerClubs, sawtooth } from '../../data/clubs';
import { contact, images } from '../../data/org';
import { clubAffiliationAgreement, policyPath } from '../../data/policies';

/** The agreement itself, so this page and its own page cannot describe it differently. */
const agreement = clubAffiliationAgreement;

/** What a partner club gets from the umbrella, by benefit. */
const benefits = [
  {
    label: 'Financial Infrastructure',
    body: 'Dedicated team bank accounts and debit cards—replacing informal Venmo transfers—plus access to non-profit discounts.',
  },
  {
    label: 'Tax-Deductible Fundraising',
    body: 'Leverage our 501(c)(3) status to offer tax write-offs for your donors and sponsors.',
  },
  {
    label: 'Event Support & Insurance',
    body: 'Structural support for hosting events, including access to comprehensive liability insurance.',
  },
  {
    label: 'Access to Drone',
    body: 'Ability to request use of the non-profit’s drone to film games.',
  },
  {
    label: 'Operational Resources',
    body: 'Unlock free or heavily discounted software tools to streamline your team management.',
  },
];

/**
 * What the agreement itself contains, so a club can see the commitments before
 * they get in touch rather than after. Summarised from the signed PDF; the
 * document is what governs.
 */
const agreementContents = [
  {
    label: 'Purpose & Scope',
    body: 'The operational terms, mutual benefits, and financial obligations the affiliation creates between your club and our 501(c)(3).',
  },
  {
    label: 'Independent Entity',
    body: 'Your club is a separate entity, not a branch of ours, and we carry no liability for its contracts, injuries, or debts.',
  },
  {
    label: 'Board Representation',
    body: 'At least one active club leader sits on our board of directors, and names a successor in writing if they step down.',
  },
  {
    label: 'Benefits Provided',
    body: 'The dedicated bank account, tax-deductible giving, tax-exempt purchasing, travel and booking rates, software, and event insurance we extend.',
  },
  {
    label: 'Financial Protocols',
    body: 'No organizational debt, and every purchase pre-funded and cleared before it is made, with receipts and treasurer approval.',
  },
  {
    label: 'Insurance',
    body: 'We do not cover your practices, league games, or travel — your club procures any liability and participant cover it needs.',
  },
  {
    label: 'Term & Departure',
    body: 'The affiliation runs season to season, ends on thirty days’ notice, and leaves any remaining funds to another qualifying 501(c)(3).',
  },
];
---

<BaseLayout
  title="Partner Information — Treasure Valley Ultimate"
  description="Treasure Valley Ultimate provides professional infrastructure for teams so players and coaches can focus on competition and player growth."
>
  <PageHero
    eyebrow="Partner Clubs"
    title={partnerClubs.headline}
    lede={partnerClubs.intro}
  />

  <!-- Current partner club -->
  <Section tone="page">
    <Container>
      <SectionHeader title="Current partner club" />

      <div class="partner">
        <figure class="partner__media">
          <img
            src={images.rosterBoise}
            alt="The Sawtooth roster on a park field with the foothills behind them."
            width="1750"
            height="1318"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="partner__body">
          <h3 class="partner__subtitle">{sawtooth.name}</h3>
          <p class="partner__text">
            Sawtooth is Idaho’s premier competitive Open club team. Named after the
            Sawtooth mountain range, we compete in the Big Sky Section and the
            Northwest Region.
          </p>
          <Button href="/partner-clubs/sawtooth-ultimate/">
            Learn About Sawtooth
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Partnership benefits -->
  <Section tone="raised">
    <Container>
      <div class="columns">
        <div class="columns__list">
          <SectionHeader title="Partnership Benefits" level={2} />
          <dl class="benefits">
            {
              benefits.map((benefit) => (
                <div class="benefits__item">
                  <dt class="benefits__label">{benefit.label}</dt>
                  <dd class="benefits__body">{benefit.body}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <figure class="columns__media">
          <img
            src={images.boiseLandscape}
            alt="Line drawing of the Boise cityscape beneath a mountain and a hand."
            width="1280"
            height="1126"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </Container>
  </Section>

  <!-- How to affiliate -->
  <Section tone="accent">
    <Container>
      <div class="affiliate">
        <Card class="affiliate__card">
          <FeatureTile
            title={partnerClubs.cta.title}
            icon="users"
            href={`mailto:${contact.general.email}`}
            cta={`Email ${contact.general.email}`}
          >
            <p>{partnerClubs.cta.body}</p>
          </FeatureTile>
        </Card>

        <div class="affiliate__steps">
          <h3 class="affiliate__steps-title">What happens next</h3>
          <ol class="steps">
            <li class="steps__item">
              <span class="steps__index">1</span>
              <span>
                Get in touch with us about your club team and the season you are
                planning.
              </span>
            </li>
            <li class="steps__item">
              <span class="steps__index">2</span>
              <span>
                We walk through the 501(c)(3) umbrella arrangement and what fiscal
                sponsorship covers for your team.
              </span>
            </li>
            <li class="steps__item">
              <span class="steps__index">3</span>
              <span>
                Your team affiliates, and gains access to tournament support, gear,
                and coaching coordination.
              </span>
            </li>
          </ol>
        </div>
      </div>
    </Container>
  </Section>

  <!-- The agreement itself -->
  <Section tone="page">
    <Container>
      <SectionHeader
        eyebrow="The agreement"
        title="What your club actually signs"
        layout="split"
        lede="Partnership runs on a short written agreement, so every club knows the same terms from the start. Here is what it covers, and you can read the whole thing before you get in touch."
      />

      <div class="agreement">
        <dl class="benefits">
          {
            agreementContents.map((item) => (
              <div class="benefits__item">
                <dt class="benefits__label">{item.label}</dt>
                <dd class="benefits__body">{item.body}</dd>
              </div>
            ))
          }
        </dl>

        <Card class="agreement__card">
          <FeatureTile title={agreement.title} icon="document" level={3}>
            <p>
              The full agreement, signed by both parties. Read it online, or
              download the original to keep with your club’s records.
            </p>
          </FeatureTile>
          <p class="agreement__meta">{agreement.download?.detail}</p>
          <div class="agreement__actions">
            <Button href={policyPath(agreement.slug)} variant="solid" size="lg">
              Read the agreement
            </Button>
            <Button href={agreement.download?.file} download variant="outline">
              {agreement.download?.label}
            </Button>
          </div>
        </Card>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  /* -------------------------------------------------------------
   * Partner club feature
   * ----------------------------------------------------------- */

  .partner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .partner__media {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: var(--border-width) solid var(--line-subtle);
    box-shadow: var(--shadow-sm);
  }

  .partner__media img {
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .partner__body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  /* The club's name, under the section title it belongs to. */
  .partner__subtitle {
    font-size: var(--text-xl);
  }

  .partner__text {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  /* -------------------------------------------------------------
   * Benefits list
   * ----------------------------------------------------------- */

  .columns {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .columns__list {
    display: grid;
    gap: var(--space-4);
  }

  .benefits {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .benefits__item {
    display: grid;
    gap: var(--space-1);
    margin: 0;
  }

  .benefits__label {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text-primary);
  }

  .benefits__body {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .columns__media {
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-5);
    background: var(--surface-inverse);
    border-radius: var(--radius-lg);
  }

  /* Line art on a dark plate, so the black strokes stay legible. */
  .columns__media img {
    inline-size: min(100%, 22rem);
    block-size: auto;
    filter: invert(1) opacity(0.85);
  }

  /* -------------------------------------------------------------
   * Affiliate steps
   * ----------------------------------------------------------- */

  .affiliate {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .affiliate__steps {
    display: grid;
    gap: var(--space-3);
  }

  .affiliate__steps-title {
    font-size: var(--text-xl);
  }

  .steps {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .steps__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .steps__index {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-pine-900);
    background: var(--color-sunset-300);
    border-radius: 50%;
  }

  /* -------------------------------------------------------------
   * The agreement
   *
   * The contents list reuses the benefits list above: same term/body
   * pairs, same styling, one definition on the page.
   * ----------------------------------------------------------- */

  /*
    Stacked by default. The card sits outside the list, so at 320px nothing can
    squeeze the terms into a narrow column beside it.
  */
  .agreement {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .agreement__card {
    gap: var(--space-4);
    justify-items: start;
  }

  .agreement__meta {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  /*
    Stacked at every width, and deliberately not switched to a row. The card is
    the narrow track of a two-column grid, and a row of two buttons sets a
    min-content floor wider than that track — which pushed the whole card past
    its column and the page past the viewport at 48rem. A column of buttons has
    no such floor: each label wraps inside its own button instead.
  */
  .agreement__actions {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  @media (min-width: 48rem) {
    .partner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-7);
    }

    .columns {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-7);
    }

    .affiliate {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-7);
    }

    /*
      `minmax(0, ...)` on both tracks: the download button's label is the widest
      in-flow child in the card, and without the zero minimum its intrinsic width
      would become the track's floor. The button wraps its label instead.
    */
    .agreement {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>