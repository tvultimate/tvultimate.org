---
/**
 * Sawtooth Ultimate — the club team and its 2025 season retrospective.
 *
 * Copy follows the original site, including the three-part structure of the
 * original season write-up.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Stat from '../../components/ui/Stat.astro';
import { sawtooth, sawtoothStats, sawtoothReport } from '../../data/clubs';
import { contact, links, funds, images } from '../../data/org';
---

<BaseLayout
  title="Sawtooth Ultimate — Treasure Valley Ultimate"
  description="Based in Boise, Sawtooth Ultimate represents the peak of men's competitive frisbee in Idaho."
>
  <PageHero eyebrow="Partner club" title={sawtooth.name} lede={sawtooth.tagline}>
    <img
      class="saw-hero__logo"
      src={images.sawtoothLogoSmall}
      alt="Sawtooth Ultimate"
      width="400"
      height="258"
      loading="lazy"
      decoding="async"
    />
  </PageHero>

  <!-- About -->
  <Section tone="page">
    <Container>
      <div class="about">
        <div class="about__prose">
          <h2 class="about__title">About the team</h2>
          <p>{sawtooth.intro}</p>
          <p>{sawtooth.mission}</p>
        </div>

        <div class="about__contact">
          <Eyebrow>Get in Touch</Eyebrow>
          <p class="about__contact-text">
            Interested in playing? Fill out the current season interest form or email
            us directly.
          </p>
          <div class="about__contact-actions">
            <Button href={links.sawtoothTryout} size="lg" external>
              Current Season Interest Form
            </Button>
            <a class="about__email" href={`mailto:${contact.sawtooth.email}`}>
              {contact.sawtooth.email}
            </a>
          </div>
        </div>
      </div>

      <ul class="stats">
        {
          sawtoothStats.map((stat) => (
            <li class="stats__item">
              <Stat value={stat.value} label={stat.label} />
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- Season review -->
  <Section tone="sunken">
    <Container>
      <SectionHeader
        eyebrow="Season review"
        title={`${sawtooth.name}: 2025 in review`}
        layout="split"
      />

      {
        sawtoothReport.map((block, index) => (
          <article class="block">
            <header class="block__head">
              <p class="block__index">{String(index + 1).padStart(2, '0')}</p>
              <div class="block__heading">
                <h3 class="block__title">{block.title}</h3>
                <p class="block__summary">{block.summary}</p>
              </div>
            </header>

            <ul class="block__highlights">
              {block.highlights.map((highlight) => (
                <li class="block__highlight">
                  <span class="block__highlight-label">{highlight.label}</span>
                  <span class="block__highlight-value">{highlight.value}</span>
                  <span class="block__highlight-note">{highlight.note}</span>
                </li>
              ))}
            </ul>

            {block.details && (
              <ul class="block__details">
                {block.details.map((detail) => (
                  <li class="block__detail">{detail}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </Container>
  </Section>

  <!-- Support -->
  <Section tone="page">
    <Container>
      <div class="support">
        <div class="support__body">
          <Eyebrow>Support the team</Eyebrow>
          <h2 class="support__title">Back Sawtooth's season</h2>
          <p class="support__text">{funds.sawtooth.blurb}</p>
        </div>
        <div class="support__actions">
          <Button href={links.sawtoothTryout} size="lg" external>
            Play for Sawtooth
          </Button>
          <Button href="/donations-and-dues/sawtooth-donations/" variant="outline" size="lg">
            Donate to the team
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .saw-hero__logo {
    inline-size: 12rem;
    max-inline-size: 40vw;
    block-size: auto;
    margin-block-start: var(--space-3);
    /* The hero is already dark, so the white mark needs no plate here. */
  }

  /* -------------------------------------------------------------
   * About
   * ----------------------------------------------------------- */

  .about {
    display: grid;
    gap: var(--space-6);
  }

  .about__prose {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--layout-measure);
  }

  .about__title {
    font-size: var(--text-xl);
  }

  .about__prose p {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .about__contact {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
    padding: var(--space-5);
    background: var(--surface-raised);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .about__contact-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .about__contact-actions {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    /* Grid and flex children default to min-content width; without this the
       button's intrinsic width overflows the column. */
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .about__email {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-accent);
  }

  /* -------------------------------------------------------------
   * Season stats
   * ----------------------------------------------------------- */

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0;
    margin: var(--space-7) 0 0;
    list-style: none;
  }

  .stats__item {
    margin: 0;
    padding: var(--space-4);
    background: var(--surface-raised);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-md);
  }

  /* -------------------------------------------------------------
   * Season review blocks
   * ----------------------------------------------------------- */

  .block {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-block-end: var(--border-width) solid var(--line-subtle);
  }

  .block:last-of-type {
    border-block-end: 0;
  }

  .block__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .block__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-sunset-500);
    padding-block-start: 0.4em;
  }

  .block__heading {
    display: grid;
    gap: var(--space-2);
  }

  .block__title {
    font-size: var(--text-xl);
  }

  .block__summary {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .block__highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .block__highlight {
    display: grid;
    gap: 0.125rem;
    align-content: start;
    margin: 0;
    padding: var(--space-3);
    background: var(--surface-accent-soft);
    border: var(--border-width) solid var(--line-accent);
    border-radius: var(--radius-md);
  }

  .block__highlight-label {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .block__highlight-value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .block__highlight-note {
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
  }

  .block__details {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .block__detail {
    position: relative;
    margin: 0;
    padding-inline-start: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .block__detail::before {
    content: '';
    position: absolute;
    inset-block-start: 0.6em;
    inset-inline-start: 0;
    inline-size: 0.375rem;
    block-size: 0.375rem;
    background: var(--color-pine-400);
    border-radius: 50%;
  }

  /* -------------------------------------------------------------
   * Support
   * ----------------------------------------------------------- */

  .support {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5);
    background: var(--surface-inverse);
    border-radius: var(--radius-lg);
  }

  .support__body {
    display: grid;
    gap: var(--space-2);
  }

  .support__title {
    font-size: var(--text-xl);
    color: var(--color-pine-50);
  }

  .support__text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-pine-200);
    max-inline-size: var(--layout-measure);
  }

  .support__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .about {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }

    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .block {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-7);
      align-items: start;
    }

    .block__head,
    .block__highlights {
      grid-column: 1;
    }

    .block__details {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-content: start;
    }

    .support {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-6);
      padding: var(--space-6);
    }
  }
</style>