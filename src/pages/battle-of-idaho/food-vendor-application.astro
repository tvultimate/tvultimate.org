---
/**
 * Food Vendor Application — invites food trucks and dessert vendors to serve at
 * the tournament.
 *
 * Deliberately absent from `data/navigation.ts`: this page is sent to vendors
 * directly, one at a time, rather than advertised. It still builds a route like
 * any other page and appears in the sitemap, so it is reachable if you ever
 * decide to link it publicly.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Grid from '../../components/ui/Grid.astro';
import Button from '../../components/ui/Button.astro';
import FeatureTile from '../../components/ui/FeatureTile.astro';
import { tournament } from '../../data/tournament';
import { contact } from '../../data/org';

/** Where the email CTA and the closing button both point. */
const APPLY_ANCHOR = '#how-to-apply';

/**
 * Secure payment form for an accepted vendor's fee. Third-party (Zeffy), so it
 * opens in a new tab and is not treated as a link on this domain.
 */
const PAY_VENDOR_FEE_URL =
  'https://www.zeffy.com/en-US/donation-form/battle-of-idaho-vendor-fee';

const vendorEmail = contact.battle.email;

/** Why a vendor says yes. Framed as the business case, not the mission. */
const opportunity = [
  {
    title: 'A captive audience that stays all day',
    body: 'Players run multiple games a day and are on-site between them. They are not passing through — they are spending the whole tournament in one place, and hungry.',
    icon: 'users' as const,
  },
  {
    title: 'Only three vendors',
    body: 'We are limiting the event to 2 food trucks and 1 dessert vendor so each of you gets real volume and a strong weekend, instead of competing with a row of trucks.',
    icon: 'shield' as const,
  },
  {
    title: 'You are the real meal',
    body: 'We provide basic morning snacks and drinks. Meals are entirely up to you — and that is where the revenue is.',
    icon: 'heart' as const,
  },
];

/** Day-by-day hours and head counts, as quoted to vendors. */
const days = [
  {
    day: 'Friday, Nov 13',
    hours: '2:00 PM – 5:00 PM',
    traffic: '150–200 athletes + spectators',
    note: 'The post-game dinner rush — the busiest window on the Friday.',
  },
  {
    day: 'Saturday, Nov 14',
    hours: '9:00 AM – 3:30 PM',
    traffic: '500 athletes + spectators',
    note: 'Our biggest day, with steady foot traffic from open to close.',
  },
  {
    day: 'Sunday, Nov 15',
    hours: '9:00 AM – 2:00 PM',
    traffic: '150–200 athletes + spectators',
    note: 'A strong finish to the weekend as the finals wrap.',
  },
];

/**
 * The copy-and-paste email template. Rendered as a styled list rather than a
 * `<pre>` so it wraps on a phone — a vendor reading this on mobile is the
 * common case, and a horizontally scrolling block would hide half the fields.
 */
const fields = [
  'Business / Food Truck Name:',
  'Contact Name:',
  'Phone Number:',
  'Brief description of your menu/cuisine:',
  'Average ticket/prep time for large crowds:',
  'Availability (Friday, Saturday, Sunday — all 3 preferred):',
  'Preferred Fee Option ($100/day Flat Fee OR 10% Revenue Split):',
  'Website or Social Media Link:',
];

/** The two ways to pay, presented as equals rather than a price list. */
const feeOptions = [
  {
    title: 'Option A — Flat booth fee',
    amount: '$100',
    unit: 'per day',
    body: 'A flat $100 per day, or $300 for the full weekend. You know the cost before you load the truck, and you keep every dollar you take in.',
    detail: 'The flat fee is a maximum, not a percentage — so on a big weekend you can take home considerably more than $300. If your sales are strong, this is the option that pays you better.',
  },
  {
    title: 'Option B — Revenue split',
    amount: '10%',
    unit: 'of sales',
    body: 'Nothing up front and nothing out of your pocket. You pay 10% of what you actually sell, once, at the end of the weekend, and keep the other 90%.',
    detail: 'A strong weekend can make this worth more than the flat fee. It is also the safer of the two: if the weather turns or the crowd is light, you still keep 90% of what you sold instead of paying a flat $100 for a slow day.',
  },
];

/**
 * What we actually weigh when choosing between applicants. Stated plainly so
 * vendors can self-select before they spend an afternoon writing an email.
 */
const selection = [
  {
    title: 'You can feed a rush',
    body: 'Saturday alone puts several hundred people through your window in about six hours, and it happens in waves rather than evenly. Tell us your average ticket and how fast you can push food out — we would rather hear an honest number than a flattering one.',
    icon: 'users' as const,
  },
  {
    title: 'You want all three days',
    body: 'Friday, Saturday and Sunday is the goal. A vendor who covers the whole weekend is worth more to us than two vendors who split the days, so say plainly which days you can do.',
    icon: 'calendar' as const,
  },
  {
    title: 'You are flexible on hours',
    body: 'Game times move, a bracket runs long, and a good day can stretch an hour past when we said we would close. The published hours are a target, not a hard stop — we need someone who treats them that way.',
    icon: 'clock' as const,
  },
  {
    title: 'Your menu fits the crowd',
    body: 'Athletes and parents eating on a curb between games, not a seated dinner service. Fast handheld items that the majority of people would enjoy!',
    icon: 'heart' as const,
  },
];
---

<BaseLayout
  title={`Food Vendor Application — ${tournament.name} ${tournament.year}`}
  description={`Apply to serve food at the ${tournament.edition} ${tournament.name} at ${tournament.location}, ${tournament.dates}. Limited to 2 food trucks and 1 dessert vendor.`}
>
  <PageHero
    eyebrow="Vendor opportunity"
    title={`Become a Food Vendor at the ${tournament.edition} ${tournament.name}!`}
    lede={`Join us ${tournament.dates}, at ${tournament.location} in Meridian, Idaho, and serve hundreds of hungry athletes and spectators.`}
  >
    <div class="hero-actions">
      <Button href={APPLY_ANCHOR} variant="solid" size="lg">
        Apply via Email
      </Button>
    </div>
  </PageHero>

  <Section tone="page">
    <Container>
      <p class="intro">
        We run {tournament.name} as a fundraising tournament for a non-profit, and
        every vendor fee goes straight back into our youth and community programs.
        We are looking for food trucks and a dessert vendor to feed our athletes,
        their families, and the spectators who come out to watch.
      </p>
    </Container>
  </Section>

  <Section tone="raised">
    <Container>
      <SectionHeader
        eyebrow="The opportunity"
        title="Why partner with us"
        layout="split"
      />

      <Grid min="17rem">
        {
          opportunity.map((item) => (
            <Card>
              <FeatureTile title={item.title} icon={item.icon}>
                <p>{item.body}</p>
              </FeatureTile>
            </Card>
          ))
        }
      </Grid>
    </Container>
  </Section>

  <Section tone="page">
    <Container>
      <SectionHeader
        eyebrow="Schedule and traffic"
        title="What the weekend looks like"
        lede="These are the hours we expect you to be open, and roughly how many people are on-site."
        layout="split"
      />

      <ol class="days">
        {
          days.map((day) => (
            <li class="day">
              <div class="day__head">
                <h3 class="day__name">{day.day}</h3>
                <p class="day__hours">{day.hours}</p>
              </div>
              <p class="day__traffic">{day.traffic}</p>
              <p class="day__note">{day.note}</p>
            </li>
          ))
        }
      </ol>

      <p class="hours__note">
        <strong>These hours are an estimate, not a commitment.</strong> They run
        off the game schedule, and game schedules are not locked in until teams
        are set closer to the weekend — so these times can move, in either
        direction. We are completely fine with you staying open longer or
        closing earlier, whichever you think will be best for your business. We
        will confirm the final hours with you once the teams are set.
      </p>
    </Container>
  </Section>

  <Section tone="sunken">
    <Container>
      <SectionHeader
        eyebrow="Fees"
        title="Two ways to pay"
        lede="Pick whichever fits your business. Every dollar comes straight back into our non-profit youth and community programs."
        layout="stack"
        class="fees__header"
      />

      <Grid min="17rem">
        {
          feeOptions.map((option) => (
            <Card class="fee">
              <p class="fee__title">{option.title}</p>
              <p class="fee__amount">
                {option.amount} <span class="fee__unit">{option.unit}</span>
              </p>
              <p class="fee__body">{option.body}</p>
              <p class="fee__detail">{option.detail}</p>
            </Card>
          ))
        }
      </Grid>
    </Container>
  </Section>

  <Section tone="page">
    <Container>
      <SectionHeader
        eyebrow="Selection"
        title="How we choose who we pick"
        lede="We only have two food truck slots and one dessert slot, so we do have to turn people down. These are the things we weigh, in plain terms, so you can tell whether it is worth applying."
        layout="stack"
        class="selection__header"
      />

      {/*
        Written out rather than using ui/Grid: four criteria want a balanced
        2x2 block, and auto-fit would break them 3 + 1.
      */}
      <div class="selection__grid">
        {
          selection.map((item) => (
            <Card>
              <FeatureTile title={item.title} icon={item.icon}>
                <p>{item.body}</p>
              </FeatureTile>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section tone="raised" id="how-to-apply">
    <Container>
      <SectionHeader
        eyebrow="How to apply"
        title="Send us one email"
        layout="stack"
        class="apply__header"
      />

      <div class="apply">
        <div class="apply__aside">
          <div class="template">
            <p class="template__subject">
              <span class="template__key">Subject:</span> Food Vendor Application — [Your
              Food Truck Name]
            </p>
            <ul class="template__fields">
              {
                fields.map((field) => (
                  <li class="template__field">{field}</li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="apply__body">
          <p class="apply__text">
            Copy the template, fill in the blanks, and send it to{' '}
            <a class="apply__email" href={`mailto:${vendorEmail}`}>{vendorEmail}</a>.
            A tournament director reads every application and replies with next
            steps within a few days.
          </p>
          <p class="apply__note">
            Applying commits you to nothing. Tell us which days and which fee
            option work for you, and we will confirm the details in writing
            before you plan for the trip.
          </p>

          <div class="apply__actions">
            <Button
              href={`mailto:${vendorEmail}?subject=Food%20Vendor%20Application`}
              variant="solid"
              size="lg"
            >
              Email {vendorEmail}
            </Button>
          </div>
        </div>
      </div>

      {/*
        Payment sits below the apply panel rather than inside it: a vendor
        reading this page cold is not a vendor who has already been selected,
        and a payment link sitting beside "Apply via email" invites the wrong
        one of them to use it. Deliberately outline weight, because this
        section already spends its single solid action on the application.
      */}
      <div class="pay">
        <div class="pay__body">
          <p class="pay__label">Already selected?</p>
          <p class="pay__text">
            If you have been chosen and are ready to pay your vendor fee, use
            the link below. It opens our secure payment form, and the fee is due
            before you arrive on site.
          </p>
        </div>

        <div class="pay__actions">
          <Button href={PAY_VENDOR_FEE_URL} variant="outline" size="lg" external>
            Pay your vendor fee
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }

  .intro {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  /* -------------------------------------------------------------
   * Schedule
   *
   * A list, not a table: it stacks without horizontal scroll on a
   * phone, which is where a vendor will actually read it.
   * ----------------------------------------------------------- */
  .days {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .day {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--surface-raised);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .day__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
    justify-content: space-between;
  }

  .day__name {
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  .day__hours {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: var(--tracking-snug);
    color: var(--text-accent);
  }

  .day__traffic {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--text-accent);
  }

  .day__note {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  /*
   * The published hours are provisional, and that caveat is worth more than a
   * footnote — it is the thing a vendor is actually anxious about. Set as a
   * ruled note so it reads as a condition on the list above it.
   */
  .hours__note {
    margin-block-start: var(--space-5);
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width-thick) solid var(--line-accent);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .hours__note strong {
    color: var(--text-primary);
  }

  /* -------------------------------------------------------------
   * Selection
   * ----------------------------------------------------------- */
  .selection__grid {
    display: grid;
    gap: var(--space-4);
  }

  /* -------------------------------------------------------------
   * Fees
   * ----------------------------------------------------------- */
  .fees__header,
  .selection__header {
    /* The lede reads as a subheader under the title, not as a competing
       column beside it, so it is capped rather than floated wide. */
    max-inline-size: var(--layout-measure);
  }

  .fee {
    gap: var(--space-2);
  }

  .fee__title {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-warm);
  }

  .fee__amount {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--text-primary);
  }

  .fee__unit {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-normal);
    text-transform: none;
    color: var(--text-tertiary);
  }

  .fee__body {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  /* The second line in each fee card is the part that actually helps a vendor
     choose, so it gets its own weight rather than reading as another sentence
     of the same pitch. */
  .fee__detail {
    margin-block-start: var(--space-2);
    padding-block-start: var(--space-3);
    border-block-start: var(--border-width) solid var(--line-subtle);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
  }

  /* -------------------------------------------------------------
   * Apply
   *
   * Deliberately a light section. The footer is `--surface-inverse`,
   * and a dark CTA directly above it read as one tall green block
   * with no edge between them — the closing section now sits on the
   * raised surface and hands off to the footer cleanly.
   * ----------------------------------------------------------- */
  .apply {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .apply__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .apply__text {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .apply__note {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .apply__email {
    font-weight: 700;
    color: var(--text-accent);
    overflow-wrap: anywhere;
  }

  .apply__aside {
    display: grid;
    gap: var(--space-4);
  }

  /*
   * The template is the one thing a visitor will copy, so it gets a
   * panel of its own rather than sitting loose in the prose. Long
   * email addresses are allowed to wrap rather than overflow.
   */
  .template {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--surface-sunken);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-lg);
  }

  .template__subject {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-width) solid var(--line-subtle);
  }

  .template__key {
    color: var(--text-tertiary);
    font-weight: 600;
  }

  .template__fields {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .template__field {
    /* A vendor's answer here can be long; never clip it. */
    overflow-wrap: anywhere;
  }

  .template__field::before {
    content: '·';
    display: inline-block;
    inline-size: 1ch;
    color: var(--text-accent);
  }

  .apply__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* -------------------------------------------------------------
   * Pay
   *
   * A ruled-off closing note. The rule above is what makes it read as a
   * separate step rather than as a third bullet in the apply panel.
   * ----------------------------------------------------------- */
  .pay {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-width) solid var(--line-subtle);
  }

  .pay__body {
    display: grid;
    gap: var(--space-2);
  }

  .pay__label {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-warm);
  }

  .pay__text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .pay__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .pay {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-7);
      justify-items: stretch;
    }

    .pay__actions {
      justify-content: flex-end;
    }

    .selection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .apply {
      /* The template is the thing to copy, so it takes the wider track. */
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>