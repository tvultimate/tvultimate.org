---
/**
 * 2026 Battle of Idaho — the flagship tournament.
 *
 * Divisions lead the page: a captain arrives knowing their division, their
 * schedule, and where the living documents are. The divisions selector is a
 * React island because it keeps one division's detail in the DOM at a time.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Icon from '../../components/ui/Icon.astro';
import PricingTiers from '../../components/sections/tournament/PricingTiers.astro';
import FoodVendors from '../../components/sections/tournament/FoodVendors.astro';
import SponsorWall from '../../components/sections/tournament/SponsorWall.astro';
import FieldMap from '../../components/sections/tournament/FieldMap.astro';
import DivisionTabs from '../../components/react/DivisionTabs';
import {
  tournament,
  divisions,
  stats,
  pricing,
  youthPricingNote,
  freeAgentPolicy,
  gameRules,
  scheduleNote,
  amenities,
  foodVendors,
  foodIntro,
  housing,
  fundraising,
  directors,
} from '../../data/tournament';
import { contact, links } from '../../data/org';
---

<BaseLayout
  title={`${tournament.name} ${tournament.year} — Treasure Valley Ultimate`}
  description={`${tournament.tagline}. ${tournament.dates} at ${tournament.location}, ${tournament.address}.`}
>
  <PageHero
    eyebrow={`${tournament.edition} · ${tournament.year}`}
    title={tournament.name}
    lede={tournament.intro}
  >
    <ul class="boi__hero-meta">
      <li class="boi__hero-meta-item">
        <span class="boi__hero-meta-icon"><Icon name="calendar" /></span>
        {tournament.dates}
      </li>
      <li class="boi__hero-meta-item">
        <span class="boi__hero-meta-icon"><Icon name="pin" /></span>
        {tournament.location}, Meridian
      </li>
      <li class="boi__hero-meta-item">
        <span class="boi__hero-meta-icon"><Icon name="users" /></span>
        Youth Open · Adult Mixed · Adult Open
      </li>
    </ul>

    <div class="boi__hero-actions">
      <Button href={links.battleRegistration} variant="solid" size="lg" external>
        Register
      </Button>
      <Button href={links.discord} variant="quiet" size="lg" external>
        Join the Discord for updates
      </Button>
      <Button
        href="/battle-of-idaho/battle-of-idaho-sponsorship/"
        variant="quiet"
        size="lg"
      >
        Sponsor the event
      </Button>
    </div>
  </PageHero>

  <!-- Divisions, schedules, and the living documents -->
  <Section id="divisions" tone="page">
    <Container>
      <SectionHeader
        eyebrow="Divisions"
        title="Choose your division"
        lede="Open to all skill levels. We limit each division to 16 teams and maintain a waitlist once a division reaches capacity. Every team is guaranteed five games, whatever the results."
      />

      <div class="boi__divisions">
        <DivisionTabs
          client:visible
          divisions={divisions}
          gameRules={gameRules}
          scheduleHref={links.battleSchedule}
          scheduleNote={scheduleNote}
        />
      </div>

      <div class="boi__resources">
        <Card as="section" class="boi__resource">
          <p class="boi__resource-eyebrow">Game schedule</p>
          <h3 class="boi__resource-title">Not final until Wednesday at 11:59 PM</h3>
          <p class="boi__resource-text">
            The draw is live while teams are still registering. Check back after
            registration closes for the final schedule.
          </p>
          <Button href={links.battleSchedule} variant="outline" size="md" external>
            View the game schedule
          </Button>
        </Card>

        <Card as="section" class="boi__resource">
          <p class="boi__resource-eyebrow">Player packet</p>
          <h3 class="boi__resource-title">Everything for the weekend</h3>
          <p class="boi__resource-text">
            Schedule, rules, score reporting, medical support, parking, and venue
            logistics in one living document.
          </p>
          <Button href={links.playerHandbook} variant="outline" size="md" external>
            Open the player packet
          </Button>
        </Card>

        <Card as="section" class="boi__resource">
          <p class="boi__resource-eyebrow">Field map</p>
          <h3 class="boi__resource-title">Heroes Park layout</h3>
          <p class="boi__resource-text">
            Fields 1–10, Tournament Central, medical, restrooms, the food truck,
            water stations, and parking.
          </p>
          <Button href="#field-map" variant="outline" size="md">
            View the field map
          </Button>
        </Card>
      </div>

      <ul class="boi__stats">
        {
          stats.map((stat) => (
            <li class="boi__stat">
              <span class="boi__stat-value">{stat.value}</span>
              <span class="boi__stat-unit">{stat.unit}</span>
              <span class="boi__stat-label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- Cost & registration -->
  <Section tone="raised">
    <Container>
      <SectionHeader eyebrow="Cost & registration" title="Bring your own team, fund the future" />
      <p class="boi__lede">{fundraising}</p>
      <PricingTiers tiers={[...pricing]} />
      <p class="boi__pricing-note">{youthPricingNote}</p>
      <p class="boi__footnote">{freeAgentPolicy}</p>
    </Container>
  </Section>

  <!-- Amenities & housing -->
  <Section tone="sunken">
    <Container>
      <SectionHeader
        eyebrow="Amenities & housing"
        title="We take care of the details"
      />
      <div class="split">
        <div>
          <h3 class="boi__subhead">On site</h3>
          <ul class="boi__list">
            {
              amenities.map((amenity) => (
                <li class="boi__item">
                  <span class="boi__item-icon">
                    <Icon name="check" />
                  </span>
                  {amenity}
                </li>
              ))
            }
          </ul>

          <h3 class="boi__subhead boi__subhead--spaced">Food trucks</h3>
          <FoodVendors vendors={foodVendors} intro={foodIntro} />
        </div>

        <div>
          <h3 class="boi__subhead">Where to stay</h3>
          <p class="boi__lede">{housing}</p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Field map -->
  <Section id="field-map" tone="page">
    <Container>
      <SectionHeader
        eyebrow="Venue"
        title="Field map"
        lede={`${tournament.location} in Meridian. Every field, Tournament Central, medical support, restrooms, food, water, and parking on one map.`}
      />
      <FieldMap />
    </Container>
  </Section>

  <!-- Contact & directors -->
  <Section tone="inverse">
    <Container>
      <div class="boi__contact">
        <div>
          <Eyebrow>Contact Information</Eyebrow>
          <h2 class="boi__contact-title">Questions before you sign up?</h2>
          <p class="boi__contact-text">
            For any questions please reach out to us at{' '}
            <a class="boi__link" href={`mailto:${contact.battle.email}`}>
              {contact.battle.email}
            </a>
            .
          </p>
        </div>

        <div class="boi__directors">
          <p class="boi__directors-heading">Tournament Directors</p>
          <ul class="boi__directors-list">
            {
              directors.map((director) => (
                <li class="boi__director">
                  <span class="boi__director-name">{director.name}</span>
                  <span class="boi__director-role">
                    {director.role} · {director.detail}
                  </span>
                  <a
                    class="boi__link boi__director-email"
                    href={`mailto:${director.email}`}
                  >
                    {director.email}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="boi__final">
        <p class="boi__final-title">Ready to battle?</p>
        <p class="boi__final-lede">
          Sign up today and help us grow the sport we love.
        </p>
        <div class="boi__final-actions">
          <Button href={links.battleRegistration} variant="solid" size="lg" external>
            Register a Team
          </Button>
          <Button
            href={links.battleRegistration}
            variant="quiet"
            size="lg"
            external
          >
            Register as a Free Agent
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Sponsors -->
  <Section tone="page">
    <Container>
      <SectionHeader
        eyebrow="Thank you"
        title="Our sponsors"
        lede={`${tournament.edition} ${tournament.name} runs on the support of these local businesses. Their sponsorship keeps entry fees low and every division open.`}
      />
      <SponsorWall sponsors={tournament.sponsors} />
      <p class="boi__thanks-actions">
        <Button
          href="/battle-of-idaho/battle-of-idaho-sponsorship/"
          variant="outline"
          size="lg"
        >
          Become a sponsor
        </Button>
      </p>
    </Container>
  </Section>
</BaseLayout>

<style>
  .boi__hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    margin: var(--space-4) 0 0;
    list-style: none;
  }

  .boi__hero-meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-pine-200);
  }

  .boi__hero-meta-icon {
    color: var(--color-sunset-300);
  }

  .boi__hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }

  .boi__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0;
    margin: var(--space-6) 0 0;
    list-style: none;
  }

  .boi__stat {
    display: grid;
    gap: 0.125rem;
    align-content: start;
    margin: 0;
    padding: var(--space-4);
    background: var(--surface-raised);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-md);
  }

  .boi__stat-value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .boi__stat-unit {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-warm);
  }

  .boi__stat-label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .boi__lede {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .boi__footnote {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
    margin-block-start: var(--space-5);
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width-thick) solid var(--color-sunset-500);
  }

  /*
   * The youth rate is a footnote to the price list, not a third price card,
   * so it reads smaller than the tiers it sits under.
   */
  .boi__pricing-note {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
    margin-block-start: var(--space-3);
  }

  /*
   * Spacer so the tab island sits far enough down the page that `client:visible`
   * only hydrates it once a reader actually reaches the divisions.
   */
  .boi__divisions {
    margin-block-start: var(--space-5);
  }

  .boi__resources {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .boi__resource {
    align-content: start;
    block-size: 100%;
  }

  .boi__resource-eyebrow {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-warm);
  }

  .boi__resource-title {
    font-size: var(--text-lg);
  }

  .boi__resource-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .split {
    display: grid;
    gap: var(--space-6);
  }

  /* Column headings inside a split section, under its own h2. */
  .boi__subhead {
    font-size: var(--text-lg);
  }

  /* A second heading in the same column needs to clear the list above it. */
  .boi__subhead--spaced {
    margin-block-start: var(--space-6);
  }

  .boi__list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-4) 0 0;
    list-style: none;
  }

  .boi__item {
    display: flex;
    gap: var(--space-3);
    align-items: start;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .boi__item-icon {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.1em;
    color: var(--text-accent);
  }

  /* -------------------------------------------------------------
   * Contact
   * ----------------------------------------------------------- */

  .boi__contact {
    display: grid;
    gap: var(--space-6);
    margin-block-end: var(--space-section);
  }

  .boi__contact-title {
    font-size: var(--text-2xl);
    margin-block: var(--space-3) var(--space-3);
  }

  .boi__contact-text {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-pine-100);
    max-inline-size: var(--layout-measure);
  }

  /* 24px minimum tap target (WCAG 2.5.8). */
  .boi__link {
    display: inline-block;
    padding-block: var(--space-2);
    font-weight: 650;
    color: var(--color-disc-300);
  }

  .boi__directors {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .boi__directors-heading {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-sunset-300);
  }

  .boi__directors-list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .boi__director {
    display: grid;
    gap: 0.125rem;
    margin: 0;
  }

  .boi__director-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-pine-50);
  }

  .boi__director-role {
    font-size: var(--text-xs);
    color: var(--color-pine-300);
  }

  /* The director's own address, under their name and division. */
  .boi__director-email {
    font-size: var(--text-xs);
    font-weight: 600;
    /* A long address must wrap rather than escape the column. */
    overflow-wrap: anywhere;
  }

  /* -------------------------------------------------------------
   * Final CTA
   * ----------------------------------------------------------- */

  .boi__final {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    padding: var(--space-6) var(--space-5);
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-sunset-600) 28%, transparent),
      color-mix(in oklab, var(--color-pine-700) 40%, transparent)
    );
    border: var(--border-width) solid var(--line-inverse);
    border-radius: var(--radius-xl);
  }

  .boi__final-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-pine-50);
  }

  .boi__final-lede {
    font-size: var(--text-md);
    color: var(--color-pine-100);
    max-inline-size: 34ch;
  }

  .boi__final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-block-start: var(--space-2);
  }

  /* -------------------------------------------------------------
   * Sponsors
   * ----------------------------------------------------------- */

  .boi__thanks-actions {
    margin-block-start: var(--space-6);
  }

  @media (min-width: 48rem) {
    .boi__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .boi__resources {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }

    .boi__contact {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-7);
    }

    .boi__directors-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
