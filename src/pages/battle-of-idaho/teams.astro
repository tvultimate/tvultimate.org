---
/**
 * 2026 Battle of Idaho — the entered teams.
 *
 * A snapshot page rather than a live feed: the site is static, so the field is
 * maintained in `data/teams.ts` by a director. It exists so a captain can
 * check who is already in before entering, and so the registration links have
 * a public home outside the ad landing pages.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { teamCount, teamDivisions } from '../../data/teams';
import { tournament } from '../../data/tournament';
import { links } from '../../data/org';

/** The per-division cap the tournament page also states. */
const cap = 16;
---

<BaseLayout
  title={`${tournament.year} Battle of Idaho Teams — Treasure Valley Ultimate`}
  description={`The teams entered for the ${tournament.year} Battle of Idaho at ${tournament.location}: Mixed, Open, and Youth divisions. Register a team or sign up as a free agent.`}
>
  <PageHero
    eyebrow={`${tournament.edition} · ${tournament.year}`}
    title="2026 Battle of Idaho Teams"
    lede={`${teamCount} teams are in so far for ${tournament.dates} at ${tournament.location}.`}
  >
    <div class="hero-actions">
      <Button href={links.battleRegistration} variant="solid" size="lg" external>
        Register a Team
      </Button>
      <Button
        href={links.battleRegistration}
        variant="quiet"
        size="lg"
        external
      >
        Register as a Free Agent
      </Button>
    </div>
  </PageHero>

  <Section tone="page">
    <Container>
      <SectionHeader
        eyebrow="The field"
        title="Who is signed up so far"
        lede="Every division is capped, so each team plays a real schedule. This is the field as it stands today."
      />

      <div class="divisions">
        {
          teamDivisions.map((division) => (
            <Card as="section" class="division">
              <div class="division__head">
                <h3 class="division__name">{division.name}</h3>
                <p class="division__count">
                  {division.teams.length} of {cap}
                </p>
              </div>
              <p class="division__summary">{division.summary}</p>
              <ul class="division__list">
                {division.teams.map((team) => (
                  <li class="division__team">{team}</li>
                ))}
              </ul>
            </Card>
          ))
        }
      </div>

      <p class="teams__note">
        Already on a team? Joining its roster runs through{' '}
        <a href={links.battleRegistration}>Ulticentral</a> too — the same
        platform that handles new teams and free agents.
      </p>
    </Container>
  </Section>

  <Section tone="inverse">
    <Container>
      <div class="cta">
        <h2 class="cta__title">Room for one more</h2>
        <p class="cta__lede">
          Bring a full squad, or come alone and we will place you on a dedicated
          free agent team.
        </p>
        <div class="cta__actions">
          <Button href={links.battleRegistration} variant="solid" size="lg" external>
            Register a Team
          </Button>
          <Button
            href={links.battleRegistration}
            variant="quiet"
            size="lg"
            external
          >
            Register as a Free Agent
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }

  .divisions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    margin-block-start: var(--space-5);
  }

  .division {
    align-content: start;
  }

  .division__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .division__name {
    font-size: var(--text-lg);
  }

  .division__count {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .division__summary {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .division__list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .division__team {
    margin: 0;
    padding-block-end: var(--space-2);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    border-block-end: var(--border-width) solid var(--line-subtle);
  }

  .division__team:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  .teams__note {
    max-inline-size: var(--layout-measure);
    margin-block-start: var(--space-5);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .cta {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    max-inline-size: var(--layout-measure);
    margin-inline: auto;
    text-align: center;
  }

  .cta__title {
    font-size: var(--text-2xl);
  }

  .cta__lede {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-block-start: var(--space-2);
  }
</style>
