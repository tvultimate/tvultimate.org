---
/**
 * Base layout for every page: head, masthead, footer.
 *
 * Pages pass their own title and description. The masthead reads `Astro.url`
 * to work out which section is active, so no navigation state is threaded
 * through props.
 */

import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/tabs.css';
import '../styles/embed.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { images } from '../data/org';

interface Props {
  title: string;
  description: string;
  /**
   * Keep the page out of search results. Set on the Google Ads landing pages
   * so they do not compete in organic search with the pages they sit beside,
   * nor cannibalise the ad spend. They are also absent from the sitemap; see
   * the `filter` in astro.config.mjs. Both are needed: a sitemap omission
   * alone does not stop a page being indexed from an inbound link.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18508946300"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18508946300');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d2118" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={images.logo} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap"
    />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--color-pine-900);
    text-decoration: none;
    background: var(--color-pine-50);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    transform: translateY(-150%);
    transition: transform var(--motion-fast) var(--ease-out-soft);
  }

  .skip:focus-visible {
    transform: translateY(0);
  }
</style>