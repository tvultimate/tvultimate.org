---
/**
 * Sponsor marks in a single row: the thank-you at the foot of the tournament
 * page. Data-driven, so adding a sponsor is an edit to `data/tournament.ts`
 * rather than another figure here.
 */

export interface Sponsor {
  readonly name: string;
  readonly logo: string;
  readonly width: number;
  readonly height: number;
}

interface Props {
  sponsors: readonly Sponsor[];
}

const { sponsors } = Astro.props;
---

<ul class="wall">
  {
    sponsors.map((sponsor) => (
      <li class="wall__item">
        <img
          class="wall__logo"
          src={sponsor.logo}
          alt={sponsor.name}
          width={sponsor.width}
          height={sponsor.height}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))
  }
</ul>

<style>
  .wall {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .wall__item {
    margin: 0;
    line-height: 0;
  }

  /*
    Sponsor marks are shown as supplied: each is a different aspect ratio and a
    different colour treatment, so normalising height keeps them on one baseline
    rather than normalising width, which would let the widest mark dominate. The
    bright plate carries the marks that are dark-on-transparent.
  */
  .wall__logo {
    display: block;
    block-size: var(--space-7);
    inline-size: auto;
    max-inline-size: 100%;
    object-fit: contain;
    object-position: left center;
    padding: var(--space-1) var(--space-2);
    background: var(--surface-bright);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-xs);
  }
</style>