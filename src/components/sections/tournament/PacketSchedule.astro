---
/**
 * The weekend schedule, division by division. Start times and round details
 * come from the shared `divisions` data, so the packet and the tournament
 * page cannot advertise different schedules.
 */

import Card from '../../ui/Card.astro';
import { packetSchedule } from '../../../data/playerPacket';
---

<ul class="schedule">
  {
    packetSchedule.map((division) => (
      <li>
        <Card as="div" class="division">
          <div class="division__head">
            <h3 class="division__name">{division.name}</h3>
            <p class="division__dates">{division.dates}</p>
          </div>
          <ul class="division__rounds">
            {division.schedule.map((round) => (
              <li class="division__round">
                <span class="division__day">{round.day}</span>
                <span class="division__detail">{round.detail}</span>
              </li>
            ))}
          </ul>
          {division.note && <p class="division__note">{division.note}</p>}
        </Card>
      </li>
    ))
  }
</ul>

<style>
  .schedule {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .schedule > li {
    margin: 0;
  }

  .division {
    block-size: 100%;
  }

  .division__head {
    display: grid;
    gap: var(--space-1);
  }

  .division__name {
    font-size: var(--text-lg);
  }

  .division__dates {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-warm);
  }

  .division__rounds {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-2) 0 0;
    list-style: none;
  }

  .division__round {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding-block-start: var(--space-2);
    border-block-start: var(--border-width) solid var(--line-subtle);
  }

  .division__day {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .division__detail {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-primary);
  }

  .division__note {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }
</style>
