---
/**
 * The Heroes Park field map. One component for the tournament page and the
 * printed packet so the layout, dimensions, and caption cannot drift apart.
 */

import { fieldMap } from '../../../data/tournament';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<figure class:list={['field-map', className]}>
  <img
    class="field-map__image"
    src={fieldMap.src}
    alt={fieldMap.alt}
    width={fieldMap.width}
    height={fieldMap.height}
    loading="lazy"
    decoding="async"
  />
  <figcaption class="field-map__caption">
    {fieldMap.caption}
    <a class="field-map__open" href={fieldMap.src} target="_blank" rel="noopener noreferrer">
      Open the full-size field map
    </a>
  </figcaption>
</figure>

<style>
  .field-map {
    margin: 0;
  }

  .field-map__image {
    inline-size: 100%;
    block-size: auto;
    background: var(--surface-raised);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-lg);
  }

  .field-map__caption {
    margin-block-start: var(--space-3);
    max-inline-size: var(--layout-measure);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .field-map__open {
    display: block;
    inline-size: fit-content;
    min-block-size: 1.75rem;
    margin-block-start: var(--space-2);
    padding-block: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--text-link);
  }
</style>
