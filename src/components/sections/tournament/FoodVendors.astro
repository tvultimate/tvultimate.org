---
/**
 * The food vendors booked for the tournament, the promise that they are on
 * site for the whole weekend, and each vendor's menu as a download.
 *
 * Kept as its own component because it is a fact about the event rather than
 * part of the amenities list: it names who is cooking, and the vendor list is
 * data, not prose.
 */

import Icon from '../../ui/Icon.astro';

interface Menu {
  label: string;
  file: string;
  detail: string;
}

interface Vendor {
  name: string;
  detail: string;
  /** The vendor's own menu, registered in `documents` in `data/org.ts`. */
  menu?: Menu;
}

interface Props {
  vendors: readonly Vendor[];
  intro: string;
}

const { vendors, intro } = Astro.props;
---

<div class="food">
  <p class="food__intro">{intro}</p>
  <ul class="food__list">
    {
      vendors.map((vendor) => (
        <li class="food__vendor">
          <span class="food__name">{vendor.name}</span>
          <span class="food__detail">{vendor.detail}</span>
          {vendor.menu && (
            <a
              class="food__menu"
              href={vendor.menu.file}
              download
              aria-label={`Download the ${vendor.menu.label} (${vendor.menu.detail})`}
            >
              <Icon name="document" class="food__menu-icon" />
              <span>Download menu <span class="food__menu-meta">({vendor.menu.detail})</span></span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .food__intro {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-inline-size: var(--layout-measure);
  }

  .food__list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-4) 0 0;
    list-style: none;
  }

  .food__vendor {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-raised);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-md);
  }

  .food__name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
  }

  .food__detail {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  /*
    A text link rather than a second button: it is a detail about the vendor,
    not the page's next action. The 1.75rem block size keeps it a comfortable
    tap target without turning the row into a control panel.
  */
  .food__menu {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    min-block-size: 1.75rem;
    margin-block-start: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--text-accent);
  }

  .food__menu-meta {
    font-weight: 500;
    color: var(--text-tertiary);
  }
</style>
