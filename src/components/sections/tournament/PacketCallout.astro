---
/**
 * The tournament page's pointer to the player packet. It is the one place a
 * captain is told that the weekend's reference document exists, so it links to
 * the readable page first and offers the PDF as a secondary action.
 */

import Button from '../../ui/Button.astro';
import Card from '../../ui/Card.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
import Icon from '../../ui/Icon.astro';
import { playerPacket } from '../../../data/playerPacket';

const { pdf } = playerPacket;
---

<Card as="section" class="packet-callout">
  <div class="packet-callout__body">
    <Eyebrow>Player packet</Eyebrow>
    <h2 class="packet-callout__title">{playerPacket.title}</h2>
    <p class="packet-callout__text">
      The weekend’s schedule, rules, score reporting, medical support, parking,
      and venue logistics — in one place.
    </p>
  </div>

  <div class="packet-callout__actions">
    <Button href={playerPacket.path} variant="solid" size="lg">
      Read the 2026 Player Packet
    </Button>
    <a class="packet-callout__pdf" href={pdf.file} download>
      <Icon name="document" />
      <span>Download PDF</span>
    </a>
  </div>
</Card>

<style>
  .packet-callout {
    gap: var(--space-4);
    margin-block-start: var(--space-6);
    border-color: var(--line-accent);
  }

  .packet-callout__body {
    display: grid;
    gap: var(--space-2);
  }

  .packet-callout__title {
    font-size: var(--text-xl);
  }

  .packet-callout__text {
    max-inline-size: var(--layout-measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .packet-callout__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  /*
    A text link rather than a second button: the page is the primary action,
    and the PDF is the take-away copy of it.
  */
  .packet-callout__pdf {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 1.75rem;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--text-accent);
  }
</style>
