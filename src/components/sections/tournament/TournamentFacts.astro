---
/**
 * Key facts strip for a tournament: date, venue, sponsors, registration.
 * Generic enough for any event we promote.
 */

import Icon from '../../ui/Icon.astro';

interface Fact {
  icon: 'calendar' | 'pin' | 'users' | 'sparkle';
  label: string;
  value: string;
  note?: string;
  href?: string;
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="facts">
  {
    facts.map((fact) => (
      <div class="facts__item">
        <dt class="facts__label">
          <span class="facts__icon">
            <Icon name={fact.icon} />
          </span>
          {fact.label}
        </dt>
        <dd class="facts__value">
          {fact.href ? (
            <a href={fact.href} rel="noopener noreferrer" target="_blank">
              {fact.value}
            </a>
          ) : (
            fact.value
          )}
          {fact.note && <span class="facts__note">{fact.note}</span>}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .facts__item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4);
    background: color-mix(in oklab, var(--color-pine-900) 55%, transparent);
    border: var(--border-width) solid var(--line-inverse);
    border-radius: var(--radius-md);
  }

  .facts__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-pine-300);
  }

  .facts__icon {
    font-size: var(--text-sm);
    color: var(--color-sunset-300);
  }

  .facts__value {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    color: var(--color-pine-50);
  }

  .facts__value a {
    color: var(--color-disc-300);
    text-underline-offset: 0.2em;
  }

  .facts__note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-normal);
    line-height: var(--leading-snug);
    color: var(--color-pine-200);
    text-wrap: pretty;
  }
</style>