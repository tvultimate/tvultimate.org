---
/**
 * Key facts strip for a tournament: date, venue, capacity, sponsors.
 *
 * Generic enough for any event we promote. Each fact is a label, a value, and
 * an optional note; `logos` replaces the sponsor text with real marks when they
 * are available.
 */

import Icon from '../../ui/Icon.astro';

interface Sponsor {
  readonly name: string;
  readonly logo: string;
}

interface Fact {
  icon: 'calendar' | 'pin' | 'users' | 'sparkle';
  label: string;
  value: string;
  note?: string;
  href?: string;
  /** Renders a row of sponsor logos instead of a text value. */
  logos?: readonly Sponsor[];
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="facts">
  {
    facts.map((fact) => (
      <div class="facts__item">
        <dt class="facts__label">
          <span class="facts__icon">
            <Icon name={fact.icon} />
          </span>
          {fact.label}
        </dt>
        <dd class="facts__value">
          {fact.logos ? (
            <ul class="sponsors">
              {fact.logos.map((sponsor) => (
                <li class="sponsors__item">
                  <img
                    class="sponsors__logo"
                    src={sponsor.logo}
                    alt={sponsor.name}
                    width="200"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))}
            </ul>
          ) : fact.href ? (
            <a href={fact.href} rel="noopener noreferrer" target="_blank">
              {fact.value}
            </a>
          ) : (
            fact.value
          )}
          {fact.note && <span class="facts__note">{fact.note}</span>}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  /*
  Written in semantic tokens so the widget adapts to whatever ground it sits
  on. A translucent dark fill fixed to the old dark section looked murky once
  the widget moved onto the light page surface.
*/
  .facts__item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4);
    background: var(--surface-raised);
    border: var(--border-width) solid var(--line-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }

  .facts__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .facts__icon {
    font-size: var(--text-sm);
    color: var(--text-warm);
  }

  .facts__value {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    color: var(--text-primary);
  }

  /* 24px minimum tap target (WCAG 2.5.8). */
  .facts__value a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--text-link);
    text-underline-offset: 0.2em;
  }

  .facts__note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-normal);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* -------------------------------------------------------------
   * Sponsors
   * ----------------------------------------------------------- */

  .sponsors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .sponsors__item {
    margin: 0;
    line-height: 0;
  }

  /*
    Sponsor marks are shown as supplied: each is a different aspect ratio and
    a different colour treatment, so normalising height keeps them on one
    baseline rather than normalising width, which would let the widest mark
    dominate. The white plate carries logos that are dark-on-transparent.
  */
  .sponsors__logo {
    display: block;
    block-size: 2.25rem;
    inline-size: auto;
    max-inline-size: 100%;
    object-fit: contain;
    object-position: left center;
    padding: var(--space-1) var(--space-2);
    background: var(--surface-bright);
    border-radius: var(--radius-xs);
  }
</style>