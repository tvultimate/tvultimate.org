---
/**
 * Key facts strip for a tournament: date, venue, capacity, sponsors.
 *
 * Generic enough for any event we promote. Each fact is a label, a value, and
 * an optional note; `logos` replaces the sponsor text with real marks when they
 * are available.
 */

import Icon from '../../ui/Icon.astro';

interface Sponsor {
  name: string;
  logo?: string;
}

interface Fact {
  icon: 'calendar' | 'pin' | 'users' | 'sparkle';
  label: string;
  value: string;
  note?: string;
  href?: string;
  /** Renders a row of sponsor logos instead of a text value. */
  logos?: Sponsor[];
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="facts">
  {
    facts.map((fact) => (
      <div class="facts__item">
        <dt class="facts__label">
          <span class="facts__icon">
            <Icon name={fact.icon} />
          </span>
          {fact.label}
        </dt>
        <dd class="facts__value">
          {fact.logos ? (
            <ul class="sponsors">
              {fact.logos.map((sponsor) => (
                <li class="sponsors__item">
                  {sponsor.logo ? (
                    <img
                      class="sponsors__logo"
                      src={sponsor.logo}
                      alt={sponsor.name}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    /* No logo on file: render the name as a wordmark rather
                       than describing the logo in text. */
                    <span class="sponsors__wordmark">{sponsor.name}</span>
                  )}
                </li>
              ))}
            </ul>
          ) : fact.href ? (
            <a href={fact.href} rel="noopener noreferrer" target="_blank">
              {fact.value}
            </a>
          ) : (
            fact.value
          )}
          {fact.note && <span class="facts__note">{fact.note}</span>}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .facts__item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4);
    background: color-mix(in oklab, var(--color-pine-900) 55%, transparent);
    border: var(--border-width) solid var(--line-inverse);
    border-radius: var(--radius-md);
  }

  .facts__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-pine-300);
  }

  .facts__icon {
    font-size: var(--text-sm);
    color: var(--color-sunset-300);
  }

  .facts__value {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    color: var(--color-pine-50);
  }

  .facts__value a {
    color: var(--color-disc-300);
    text-underline-offset: 0.2em;
  }

  .facts__note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-normal);
    line-height: var(--leading-snug);
    color: var(--color-pine-200);
    text-wrap: pretty;
  }

  /* -------------------------------------------------------------
   * Sponsors
   * ----------------------------------------------------------- */

  .sponsors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .sponsors__item {
    margin: 0;
  }

  .sponsors__logo {
    block-size: 2rem;
    inline-size: auto;
    max-inline-size: 9rem;
    object-fit: contain;
    object-position: left center;
  }

  /*
    Stand-in for a missing logo. Set in the display face at a larger size so
    it occupies the same visual weight a real mark would, rather than reading
    as small body text.
  */
  .sponsors__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: var(--tracking-snug);
    line-height: 1.2;
    color: var(--color-pine-50);
  }
</style>