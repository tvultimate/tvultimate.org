---
/**
 * Page hero. The compact banner on most pages, and the full-bleed treatment on
 * the home page.
 */

import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  /**
   * The page's `h1`. Required unless the caller renders its own heading in the
   * slot — there must be exactly one `h1` per page either way.
   */
  title?: string;
  lede?: string;
  /** Full-bleed dark treatment, used on the home page. */
  variant?: 'compact' | 'feature';
  class?: string;
}

const { eyebrow, title, lede, variant = 'compact', class: className } = Astro.props;
---

<!--
  `on-inverse` restates the semantic token layer for the whole subtree, so
  components inside the hero need no dark-mode variants of their own.
-->
<section
  class:list={['pagehero', 'on-inverse', `pagehero--${variant}`, className]}
>
  <Container class="pagehero__inner">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    {title && <h1 class="pagehero__title">{title}</h1>}
    {lede && <p class="lede pagehero__lede">{lede}</p>}
    <slot />
  </Container>

  {
    variant === 'feature' && (
      <div class="pagehero__field" aria-hidden="true">
        <span class="pagehero__sun" />
        <span class="pagehero__ridge pagehero__ridge--back" />
        <span class="pagehero__ridge pagehero__ridge--front" />
      </div>
    )
  }
</section>

<style>
  .pagehero {
    position: relative;
    overflow: clip;
  }

  /* -------------------------------------------------------------
   * Compact: standard page opening
   * ----------------------------------------------------------- */

  .pagehero--compact {
    padding-block: var(--space-section-tight);
    background: var(--surface-inverse);
    color: var(--text-inverse);
  }

  .pagehero--compact .pagehero__title {
    font-size: var(--text-3xl);
    color: var(--color-pine-50);
  }

  .pagehero--compact .pagehero__lede {
    margin-block-start: var(--space-3);
    color: var(--color-pine-200);
  }

  /* -------------------------------------------------------------
   * Feature: home page, full height
   * ----------------------------------------------------------- */

  .pagehero--feature {
    display: flex;
    align-items: center;
    min-block-size: calc(100svh - var(--layout-nav-height));
    padding-block: var(--space-section);
    background: var(--surface-inverse);
    color: var(--color-pine-50);
    isolation: isolate;
  }

  .pagehero--feature .pagehero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .pagehero--feature .pagehero__title {
    font-size: var(--text-4xl);
    color: var(--color-pine-50);
  }

  .pagehero--feature .pagehero__lede {
    max-inline-size: 40ch;
    color: var(--color-pine-100);
  }

  /* -------------------------------------------------------------
   * Ridge silhouettes, home page only
   * ----------------------------------------------------------- */

  .pagehero__field {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /*
    Hidden on narrow screens. Below 48rem the hero copy spans the full width, so
    any disc large enough to read as a sun lands behind the title or the lede
    and drags white text down to roughly 1.4:1. The right half of the hero only
    becomes free space once the copy is a left-hand column.

    Positioned so the ridgeline clips only its lower edge. Both ridge layers
    come after this in the DOM, so the skyline occludes the base and the sun
    reads as setting. `inset-block-end` tracks the front ridge: that ridge's box
    starts 45% down with peaks about 28% into its own height, putting the
    skyline near 39% from the hero floor, so 36% leaves a shallow overlap. The
    bright core is kept clear of the ridge on purpose, because the ridge fill is
    a dark translucent gradient and burying the core under it turns the disc
    muddy brown. `inset-inline-end` anchors the sun to the viewport rather than
    the copy column, so the title can reflow without colliding with it.
  */
  .pagehero__sun {
    position: absolute;
    inset-block-end: 66%;
    inset-inline-end: 10%;
    display: none;
    inline-size: clamp(6rem, 17vw, 14rem);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: radial-gradient(
      circle at 50% 50%,
      var(--color-sunset-100) 0%,
      var(--color-sunset-200) 40%,
      var(--color-sunset-300) 66%,
      var(--color-sunset-400) 84%
    );
  }

  .pagehero__ridge {
    position: absolute;
    inset-inline: -10%;
    block-size: 55%;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-pine-800) 70%, transparent),
      color-mix(in oklab, var(--color-pine-950) 92%, transparent)
    );
    clip-path: polygon(
      0% 100%,
      0% 62%,
      8% 48%,
      15% 58%,
      24% 34%,
      33% 52%,
      42% 30%,
      52% 46%,
      61% 28%,
      70% 50%,
      79% 36%,
      88% 54%,
      95% 44%,
      100% 58%,
      100% 100%
    );
  }

  /*
    The distant range gets its own silhouette rather than a vertically flipped
    copy of the front one. Flipping turns the polygon's full-width base into a
    hard horizontal edge along the top, which is invisible against the dark
    field but draws a visible seam across anything bright behind it.
  */
  .pagehero__ridge--back {
    inset-block-end: 21%;
    opacity: 0.5;
    block-size: 46%;
    clip-path: polygon(
      0% 100%,
      0% 74%,
      9% 58%,
      17% 70%,
      27% 50%,
      36% 66%,
      45% 46%,
      55% 64%,
      64% 48%,
      73% 68%,
      82% 54%,
      91% 70%,
      100% 58%,
      100% 100%
    );
  }

  .pagehero__ridge--front {
    inset-block-end: 0;
  }

  @media (min-width: 48rem) {
    .pagehero__sun {
      display: block;
    }

    .pagehero--compact .pagehero__title {
      font-size: var(--text-4xl);
    }
  }
</style>