---
/**
 * Site footer: a full index of every page, the contact points, the
 * non-profit statement, and the Boise skyline mark.
 */

import Container from './ui/Container.astro';
import Icon from './ui/Icon.astro';
import { org, contact, links, images } from '../data/org';
import { navSections } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="footer on-inverse">
  <Container>
    <div class="footer__columns">
      {
        navSections.map((section) => (
          <nav class="footer__col" aria-label={section.label}>
            <a class="footer__col-heading" href={section.href}>{section.label}</a>
            <ul class="footer__col-list">
              {section.children
                ?.filter((child) => child.href !== section.href)
                .map((child) => (
                  <li>
                    <a href={child.href}>{child.label}</a>
                  </li>
                ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__contact">
      <div>
        <p class="footer__col-heading">Contact</p>
        <ul class="footer__contact-list">
          <li>
            <a href={`mailto:${contact.general.email}`}>
              {contact.general.email}
            </a>
          </li>
          <li>
            <a href={links.discord} rel="noopener noreferrer" target="_blank">
              Discord
            </a>
          </li>
          <li>
            <a href={links.youtube} rel="noopener noreferrer" target="_blank">
              YouTube
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      <p>
        &copy; {year} {org.legalName}. {org.status}. {org.domain} is the official domain of{' '}
        {org.legalName}.
      </p>
      <p class="footer__org-mark">
        <Icon name="disc" />
      </p>
    </div>
  </Container>

  {/*
    The Boise cityscape, screened across the bottom of the footer. It is
    decorative and repeats information already in the branding, so it is
    hidden from assistive technology rather than described.
  */}
  <div class="footer__cityscape" aria-hidden="true">
    <img
      src={images.cityscape}
      alt=""
      width="2200"
      height="794"
      loading="lazy"
      decoding="async"
    />
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: clip;
    padding-block: var(--space-6);
    background: var(--surface-inverse);
    color: var(--color-pine-200);
  }

  /* -------------------------------------------------------------
   * Index columns
   * ----------------------------------------------------------- */

  /*
    No block-start padding: the footer's own space above the first row already
    separates it from the page. What is left is the gap before the contact row.
  */
  .footer__columns {
    display: grid;
    gap: var(--space-5);
    padding-block-end: var(--space-6);
  }

  .footer__col {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .footer__col-heading {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-pine-400);
    text-decoration: none;
    /* 24px minimum tap target (WCAG 2.5.8). */
    padding-block: var(--space-2);
  }

  a.footer__col-heading:hover {
    color: var(--color-sunset-300);
  }

  .footer__col-list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer__col-list li {
    margin: 0;
  }

  .footer__col-list a {
    font-size: var(--text-sm);
    color: var(--color-pine-100);
    text-decoration: none;
  }

  .footer__col-list a:hover {
    color: var(--color-sunset-300);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* -------------------------------------------------------------
   * Contact row
   * ----------------------------------------------------------- */

  .footer__contact {
    display: grid;
    gap: var(--space-5);
    align-items: end;
    padding-block: var(--space-5);
    border-block-start: var(--border-width) solid var(--line-inverse);
  }

  .footer__contact-list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-2) 0 0;
    list-style: none;
  }

  .footer__contact-list li {
    margin: 0;
  }

  .footer__contact-list a {
    font-size: var(--text-sm);
    color: var(--color-pine-100);
    text-decoration: none;
  }

  .footer__contact-list a:hover {
    color: var(--color-sunset-300);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* -------------------------------------------------------------
   * Cityscape screen
   *
   * A full-bleed band along the foot of the footer. The artwork is black line
   * art with its background already knocked out to alpha, so it is recoloured
   * with `filter` rather than shipping a second tinted copy.
   *
   * `currentColor` is not available to a raster image, so the tint is applied
   * here: invert to lift the black ink toward white, then a low opacity so it
   * sits behind the footer rather than competing with the text above it.
   * ------------------------------------------------------------- */

  .footer__cityscape {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    pointer-events: none;
    /* Bleeds past the container gutters to the viewport edges. */
    margin-block-start: var(--space-6);
  }

  .footer__cityscape img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    /*
      Anchored to the bottom so the ground line always meets the footer edge,
      and scaled so short viewports still see a readable amount of skyline.
    */
    object-fit: cover;
    object-position: bottom center;
    max-block-size: clamp(6rem, 22vw, 14rem);
    filter: invert(1) opacity(0.14);
    /*
      Fade the roofline out so the image reads as a horizon rather than a
      pasted-on picture.
    */
    mask-image: linear-gradient(to top, #000 55%, transparent 100%);
  }

  /* -------------------------------------------------------------
   * Legal
   * ----------------------------------------------------------- */

  /*
    Stacks above the cityscape band and is bright enough to stay legible on
    top of it. The band inverts a photographic skyline, so the backdrop under
    this line lightens to roughly stone-700 wherever a pale building falls;
    pine-400 only reaches 3.5:1 there. pine-300 clears 4.5:1 against both the
    band and the bare footer.
  */
  .footer__legal {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-1);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--line-inverse);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .footer__org-mark {
    font-size: var(--text-lg);
    color: var(--color-pine-600);
  }

  @media (min-width: 40rem) {
    .footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__legal {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-4);
    }

    .footer__org-mark {
      grid-column: 2;
      justify-self: end;
    }
  }

  @media (min-width: 48rem) {
    .footer__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .footer__contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-7);
    }

    .footer__skyline {
      justify-self: end;
    }
  }
</style>