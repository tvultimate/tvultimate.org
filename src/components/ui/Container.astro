---
/**
 * The constrained content column. Every section body sits inside one of
 * these so horizontal rhythm is identical across the whole page.
 */

interface Props {
  /** Slightly narrower column for prose-heavy sections. */
  narrow?: boolean;
  as?: 'div' | 'header' | 'footer' | 'ul' | 'article';
  class?: string;
}

const { narrow = false, as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', narrow && 'container--narrow', className]}>
  <slot />
</Tag>

<style>
  .container {
    inline-size: 100%;
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  .container--narrow {
    max-inline-size: calc(var(--layout-max) * 0.72);
  }
</style>