---
/**
 * Icon set. Inline SVGs at a shared 1em size so icons align with the text
 * they accompany. Adding an icon means adding one entry here.
 */

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths = {
  arrow: 'M2 8h12M9 3l5 5-5 5',
  calendar: 'M3 4h10v9H3zM3 7h10M6 2v3M10 2v3',
  pin: 'M8 14s4.5-4.2 4.5-7.5a4.5 4.5 0 1 0-9 0C3.5 9.8 8 14 8 14Zm0-5.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
  users: 'M6 7a2.25 2.25 0 1 0 0-4.5A2.25 2.25 0 0 0 6 7ZM1.75 13.25c0-2.2 1.9-3.75 4.25-3.75s4.25 1.55 4.25 3.75M11 6.5a2 2 0 1 0 0-4M12 9.6c1.4.4 2.4 1.6 2.4 3',
  disc: 'M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75Zm0 4.5a1.75 1.75 0 1 0 0 3.5 1.75 1.75 0 0 0 0-3.5Z',
  heart: 'M8 13.5S2 10 2 5.75A3.25 3.25 0 0 1 8 4.5a3.25 3.25 0 0 1 6 1.25C14 10 8 13.5 8 13.5Z',
  video: 'M2 4.5h8v7H2zM10 7l4-2.5v7L10 9',
  trophy: 'M5 2h6v3.5a3 3 0 0 1-6 0zM5 3H2.5v1A2.5 2.5 0 0 0 5 6.5M11 3h2.5v1A2.5 2.5 0 0 1 11 6.5M8 8.5V11M5.5 13.5h5M6 11h4l.5 2.5h-5z',
  mail: 'M2 4h12v8H2zM2 4.5l6 4 6-4',
  shield: 'M8 1.75 3 3.5v4c0 3 2.1 5.4 5 6.25 2.9-.85 5-3.25 5-6.25v-4z',
  document: 'M4 1.75h4.75L12 5v9.25H4zM8.75 1.75V5H12',
  check: 'M3 8.5l3.25 3.25L13 5',
  sparkle: 'M8 2l1.4 3.6L13 7l-3.6 1.4L8 12l-1.4-3.6L3 7l3.6-1.4z',
} as const;
---

<svg
  class="icon"
  data-name={name}
  class:list={[className]}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>

<style>
  /*
    Icons are sized here, in the component that owns the markup, rather than
    left to the caller.

    An SVG with no intrinsic size defaults to 100% of its container, so an
    unstyled icon balloons to fill whatever box it lands in. Owning the
    default means a caller can only ever make an icon smaller, never larger.

    Callers needing a different size target `:global(.their-class)` —
    Astro's scoped styles do not reach into this component's markup, so a
    parent's `.foo` selector would otherwise silently do nothing.
  */
  .icon {
    inline-size: 1em;
    block-size: 1em;
    flex: none;
    vertical-align: -0.125em;
  }
</style>