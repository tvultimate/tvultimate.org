---
/**
 * The single definition of a button on the site. Renders as an `<a>` when
 * `href` is present and a `<button>` otherwise, so callers never hand-roll
 * interactive controls with divergent styling.
 */

/**
 * Visual weight, in descending order of emphasis. This is the whole
 * hierarchy: one filled, one outlined, one quiet. A section should have at
 * most one `solid` action.
 */
type Variant = 'solid' | 'outline' | 'quiet';

interface Props {
  href?: string;
  variant?: Variant;
  size?: 'sm' | 'md' | 'lg';
  /** Renders a trailing arrow and marks the link as external. */
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

/** Retired names, mapped to their replacements with a build-time warning. */
const LEGACY: Record<string, Variant> = {
  primary: 'solid',
  secondary: 'outline',
  inverse: 'solid',
  ghost: 'quiet',
};

const {
  href,
  variant = 'solid',
  size = 'md',
  external = false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

if (variant in LEGACY) {
  console.warn(
    `[ui/Button] "${variant}" is deprecated — use "${LEGACY[variant]}" instead. ` +
      `Hierarchy is now solid > outline > quiet.`,
  );
}

const resolved: Variant = variant in LEGACY ? LEGACY[variant] : (variant as Variant);

const isExternal = external || (href?.startsWith('http') ?? false);
const classes = ['btn', `btn--${resolved}`, `btn--${size}`, className];
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      target={isExternal ? '_blank' : undefined}
      {...rest}
    >
      <span class="btn__label"><slot /></span>
      {isExternal && (
        <svg class="btn__icon" viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <path
            d="M6 3h7v7M13 3 4 12"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      )}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <span class="btn__label"><slot /></span>
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-inline: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 650;
    line-height: 1;
    letter-spacing: var(--tracking-normal);
    text-align: center;
    text-decoration: none;
    /*
      Labels wrap rather than forcing the button wider than its column. A long
      label in a narrow grid cell would otherwise push the page sideways.
    */
    text-wrap: balance;
    cursor: pointer;
    border: var(--border-width-thick) solid transparent;
    border-radius: var(--radius-pill);
    transition:
      background-color var(--motion-fast) var(--ease-out-soft),
      border-color var(--motion-fast) var(--ease-out-soft),
      color var(--motion-fast) var(--ease-out-soft),
      transform var(--motion-fast) var(--ease-out-soft);
  }

  .btn--md {
    padding-block: 0.8125rem;
  }

  .btn--lg {
    padding-block: 1.0625rem;
    font-size: var(--text-base);
  }

  /* -------------------------------------------------------------
   * Hierarchy
   *
   * Each weight is written entirely in semantic tokens, so `.on-inverse`
   * re-themes all three automatically. That is why there is no separate
   * "inverse" variant: a button on a dark ground is `variant="solid"`,
   * not a different component.
   * ----------------------------------------------------------- */

  /* Solid: the one real call to action on a screen. */
  .btn--solid {
    background: var(--btn-solid-bg);
    color: var(--btn-solid-ink);
    border-color: var(--btn-solid-bg);
  }

  .btn--solid:hover {
    background: var(--btn-solid-bg-hover);
    border-color: var(--btn-solid-bg-hover);
    transform: translateY(-0.0625rem);
  }

  /* Outline: a real alternative, one step down. */
  .btn--outline {
    background: transparent;
    color: var(--btn-outline-ink);
    border-color: var(--btn-outline-line);
  }

  .btn--outline:hover {
    background: var(--btn-outline-bg-hover);
    color: var(--btn-outline-ink-hover);
    border-color: var(--btn-outline-line-hover);
  }

  /*
    Quiet: a tertiary action. Underlined rather than bordered so it still
    reads as interactive without competing with the outline weight.
  */
  .btn--quiet {
    background: transparent;
    color: var(--btn-quiet-ink);
    border-color: transparent;
    padding-inline: var(--space-3);
    text-decoration: underline;
    text-decoration-color: var(--btn-quiet-line);
    text-underline-offset: 0.35em;
    text-decoration-thickness: var(--border-width-thick);
  }

  .btn--quiet:hover {
    background: var(--btn-quiet-bg-hover);
    color: var(--btn-quiet-ink-hover);
    text-decoration-color: currentColor;
  }

  .btn__icon {
    inline-size: 1em;
    block-size: 1em;
    flex: none;
    transition: transform var(--motion-fast) var(--ease-out-soft);
  }

  .btn:hover .btn__icon {
    transform: translate(0.125rem, -0.125rem);
  }

  .btn:active {
    transform: translateY(0);
  }
</style>